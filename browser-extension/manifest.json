{
  "manifest_version": 3,
  "name": "Muse 收藏助手 for JavDB",
  "version": "0.1.0",
  "description": "在 JavDB 影片卡片上查看该番号是否已收藏到本机 Muse。只读，不上传任何数据。",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8899/*",
    "http://localhost:8899/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Muse 收藏助手（设置请右键图标 → 选项）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://javdb.com/*",
        "*://*.javdb*.com/*",
        "*://jav.app/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
